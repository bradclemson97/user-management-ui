{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% block pageTitle %}{{ pageHeading if pageHeading else "GOV RBAC" }} - GOV RBAC{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/govuk/govuk-frontend.min.css">
{% endblock %}

{% set profileLabel %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false" style="vertical-align:middle;margin-right:0.3em;margin-bottom:0.15em"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5z"/></svg>{{ (currentUser.userDetails.firstName + " " + currentUser.userDetails.lastName) if currentUser else "Profile" }}{% endset %}

{% block header %}
  {{ govukHeader({ homepageUrl: "/" }) }}
  {{ govukServiceNavigation({
    serviceName: "GOV RBAC",
    serviceUrl: "/",
    navigation: [
      {
        href: "/profile",
        html: profileLabel,
        current: activePage == "profile"
      },
      {
        href: "/auth/logout",
        text: "Sign out"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  {% if flashMessage %}
    {{ govukNotificationBanner({
      type: flashMessage.type,
      html: "<p class=\"govuk-body\">" + flashMessage.text + "</p>"
    }) }}
  {% endif %}

  {% if errorMessage %}
    {{ govukNotificationBanner({
      type: "important",
      html: "<p class=\"govuk-body\">" + errorMessage + "</p>"
    }) }}
  {% endif %}

  {% if infoMessage %}
    {{ govukNotificationBanner({
      html: "<p class=\"govuk-body\">" + infoMessage + "</p>"
    }) }}
  {% endif %}

  {% block breadcrumbs %}{% endblock %}

  {% block pageContent %}{% endblock %}
{% endblock %}

{% block footer %}
  {{ govukFooter() }}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/js/init.js"></script>
{% endblock %}
