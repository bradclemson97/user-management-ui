{% extends "layouts/base.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageHeading = "Users" %}
{% set activePage = "list" %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <div class="govuk-!-display-flex govuk-!-justify-content-space-between govuk-!-align-items-center">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-0">Users</h1>
        {% if "User Administration" in currentUserRoles %}
          <a href="/users/create" class="govuk-button" data-module="govuk-button">
            Create user
          </a>
        {% endif %}
      </div>

      <form method="get" action="/" class="govuk-!-margin-bottom-6">
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="name">
            Search by name
          </label>
          <div class="govuk-input__wrapper">
            <input
              class="govuk-input govuk-input--width-30"
              id="name"
              name="name"
              type="search"
              value="{{ searchName }}"
              autocomplete="off"
            >
            <button type="submit" class="govuk-button govuk-!-margin-bottom-0" style="border-radius: 0 4px 4px 0;">
              Search
            </button>
          </div>
        </div>
      </form>

      {% if users.length %}
        <p class="govuk-body govuk-hint">
          {% if searchName %}
            Showing {{ users.length }} of {{ totalElements }} user{{ "s" if totalElements != 1 }} matching "<strong>{{ searchName }}</strong>"
          {% else %}
            Showing {{ users.length }} of {{ totalElements }} user{{ "s" if totalElements != 1 }}
          {% endif %}
        </p>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Name</th>
              <th scope="col" class="govuk-table__header">Email</th>
              <th scope="col" class="govuk-table__header">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for user in users %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                  <a href="/users/{{ user.systemUserId }}" class="govuk-link">
                    {{ user.userDetails.firstName }}
                    {% if user.userDetails.middleName %} {{ user.userDetails.middleName }}{% endif %}
                    {{ user.userDetails.lastName }}
                  </a>
                </td>
                <td class="govuk-table__cell">{{ user.userDetails.primaryEmail }}</td>
                <td class="govuk-table__cell">
                  <strong class="govuk-tag {% if user.active %}govuk-tag--green{% else %}govuk-tag--red{% endif %}">
                    {{ "Active" if user.active else "Inactive" }}
                  </strong>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if totalPages > 1 %}
          <nav class="govuk-!-margin-top-4" aria-label="Pagination">
            <div class="govuk-body">
              {% if currentPage > 0 %}
                {% if searchName %}
                  <a href="/?name={{ searchName }}&page={{ currentPage - 1 }}" class="govuk-link govuk-!-margin-right-4">&laquo; Previous</a>
                {% else %}
                  <a href="/?page={{ currentPage - 1 }}" class="govuk-link govuk-!-margin-right-4">&laquo; Previous</a>
                {% endif %}
              {% endif %}
              <span>Page {{ currentPage + 1 }} of {{ totalPages }}</span>
              {% if currentPage < totalPages - 1 %}
                {% if searchName %}
                  <a href="/?name={{ searchName }}&page={{ currentPage + 1 }}" class="govuk-link govuk-!-margin-left-4">Next &raquo;</a>
                {% else %}
                  <a href="/?page={{ currentPage + 1 }}" class="govuk-link govuk-!-margin-left-4">Next &raquo;</a>
                {% endif %}
              {% endif %}
            </div>
          </nav>
        {% endif %}

      {% else %}
        {% if searchName %}
          <p class="govuk-body">No users found matching "<strong>{{ searchName }}</strong>".</p>
        {% elif not infoMessage and not errorMessage %}
          <p class="govuk-body">No users found in the system.</p>
        {% endif %}
      {% endif %}

    </div>
  </div>
{% endblock %}
