{% extends "layouts/base.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageHeading = "Your profile" %}
{% set activePage = "profile" %}

{% block pageContent %}
  {{ govukBackLink({ text: "Back to users", href: "/" }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-xl">Your profile</h1>

      {% if currentUser %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Title" },
              value: { text: currentUser.userDetails.title if currentUser.userDetails.title else "—" }
            },
            {
              key: { text: "First name" },
              value: { text: currentUser.userDetails.firstName }
            },
            {
              key: { text: "Middle name" },
              value: { text: currentUser.userDetails.middleName if currentUser.userDetails.middleName else "—" }
            },
            {
              key: { text: "Last name" },
              value: { text: currentUser.userDetails.lastName }
            },
            {
              key: { text: "Email" },
              value: { text: currentUser.userDetails.primaryEmail }
            },
            {
              key: { text: "Status" },
              value: { text: "Active" if currentUser.active else "Inactive" }
            },
            {
              key: { text: "User ID" },
              value: { text: currentUser.systemUserId }
            }
          ]
        }) }}

      {% else %}
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Name" },
              value: { text: jwtUser.name }
            },
            {
              key: { text: "Email" },
              value: { text: jwtUser.email }
            },
            {
              key: { text: "User ID" },
              value: { text: jwtUser.systemUserId }
            }
          ]
        }) }}
      {% endif %}

      {{ govukButton({
        text: "Sign out",
        href: "/auth/logout",
        classes: "govuk-button--warning govuk-!-margin-top-4"
      }) }}

    </div>
  </div>
{% endblock %}
